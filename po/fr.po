msgid "Sendung wird hinzugefügt …"
msgstr "Ajout de l’envoi …"

#: src/ui/mod.rs
msgid "Sendung wurde hinzugefügt. Trackingdaten können nach der ersten Parcel-Aktualisierung erscheinen."
msgstr "L’envoi a été ajouté. Les données de suivi peuvent apparaître après la première mise à jour de Parcel."

#: src/ui/mod.rs
msgid "Sendung konnte nicht hinzugefügt werden: {error}"
msgstr "Impossible d’ajouter l’envoi : {error}"

#: src/ui/mod.rs
msgid "Die Sendung konnte nicht hinzugefügt werden."
msgstr "L’envoi n’a pas pu être ajouté."

#: src/ui/mod.rs
msgid "Bitte gib eine Sendungsnummer ein."
msgstr "Veuillez saisir un numéro de suivi."

#: src/ui/mod.rs
msgid "Bitte wähle einen Paketdienst aus."
msgstr "Veuillez sélectionner un transporteur."

#: src/ui/mod.rs
msgid "Bitte gib eine Beschreibung ein."
msgstr "Veuillez saisir une description."

#: src/ui/mod.rs
msgid "Aus der Sendungsnummer vorgeschlagen – bitte prüfen."
msgstr "Suggéré à partir du numéro de suivi — veuillez vérifier."

#: src/ui/mod.rs
msgid "Lokal als zugestellt markieren"
msgstr "Marquer comme livré localement"

#: src/ui/mod.rs
msgid "Lokale Markierung zurücknehmen"
msgstr "Annuler le marquage local"

#: src/ui/mod.rs
msgid "Lokal als zugestellt markiert"
msgstr "Marqué comme livré localement"

#: src/ui/mod.rs
msgid "Nur in Ankunft auf diesem Gerät · Parcel-Status: {status}"
msgstr "Uniquement dans Ankunft sur cet appareil · Statut Parcel : {status}"

#: src/ui/mod.rs
msgid "Weitere Sendungsoptionen"
msgstr "Plus d’options pour l’envoi"

#: src/ui/mod.rs
msgid "Die Sendung wurde lokal als zugestellt markiert."
msgstr "L’envoi a été marqué comme livré localement."

#: src/ui/mod.rs
msgid "Die lokale Markierung wurde zurückgenommen."
msgstr "Le marquage local a été annulé."

#: src/ui/mod.rs
msgid "Die lokale Markierung konnte nicht gespeichert werden: {error}"
msgstr "Impossible d’enregistrer le marquage local : {error}"

#: src/storage.rs
msgid "Der lokale Sendungsspeicher wurde aktualisiert, aber die dauerhafte Speicherung konnte nicht bestätigt werden: {0}"
msgstr "Le stockage local des envois a été mis à jour, mais son écriture durable n’a pas pu être confirmée : {0}"

msgid "Im Hintergrund weiterlaufen"
msgstr "Continuer en arrière-plan"

msgid "Sendungen alle 15 Minuten prüfen, auch bei geschlossenem Fenster."
msgstr "Vérifier les livraisons toutes les 15 minutes, même lorsque la fenêtre est fermée."

msgid "Beenden"
msgstr "Quitter"

msgid "Hintergrundbetrieb wurde nicht erlaubt. Das Fenster bleibt geöffnet."
msgstr "Le fonctionnement en arrière-plan n’a pas été autorisé. La fenêtre reste ouverte."

msgid "Sendungen prüfen und über wichtige Änderungen informieren."
msgstr "Vérifier les livraisons et signaler les changements importants."
